# Copy this file to `.env` in the repo root before deploying anywhere that
# isn't your local machine. docker-compose.yml reads these automatically.
#
# The defaults baked into docker-compose.yml match local dev, so `.env` is
# optional for `docker compose up` on your laptop — but required for a real
# deployment (physical server, staging, etc).

# --- Postgres ---
POSTGRES_USER=petrodata
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=petrodata
POSTGRES_PORT=5435

# --- Backend ---
APP_ENV=production
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string
BACKEND_PORT=8081
# Only matters for browsers calling the backend directly, bypassing Caddy
# (Caddy's same-origin setup below needs no CORS at all). Comma-separated
# if you need more than one, e.g. https://invoices.example.com,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Networking ---
# Leave unset to bind on all interfaces (0.0.0.0), same as today. Set this
# if the server hosts other applications and you've been given a dedicated
# IP for this app — every service (Postgres, backend, frontend, Caddy)
# binds ONLY to that IP, so it can't collide with anything else on the box
# even if both use port 80. See README's "Dedicated IP" section.
# BIND_IP=10.0.0.50

# --- Frontend ---
# Baked in at `docker compose build` time (Next.js inlines NEXT_PUBLIC_* at
# build, not runtime) — set this to how the backend is actually reachable
# from users' browsers before building.
#
# The stack ships with a `caddy` service that fronts both frontend and
# backend on one HTTP origin (plain HTTP, LAN-only — see Caddyfile), so API
# requests can go through the same origin as the page. Leave this EMPTY for
# that setup:
NEXT_PUBLIC_API_URL=
# If you're bypassing Caddy and hitting the backend container directly
# instead, set the full URL, e.g. http://<server-lan-ip>:8081
FRONTEND_PORT=3000
