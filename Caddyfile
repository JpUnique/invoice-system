# Reverse proxy for the LAN-only deployment: terminates TLS with a
# locally-trusted self-signed cert (no public domain needed) and routes
# API/upload paths to the backend, everything else to the frontend.
#
# First visit will show a browser warning for the self-signed cert — click
# through once, or install Caddy's local root CA
# (https://caddyserver.com/docs/running#local-https-with-docker) to trust it.
{
	auto_https disable_redirects
}

:443 {
	tls internal {
		on_demand
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /uploads/* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:3000
	}
}

:80 {
	redir https://{host}{uri} permanent
}
