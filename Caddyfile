# Reverse proxy for the LAN-only deployment: plain HTTP, no TLS. Routes
# API/upload paths to the backend, everything else to the frontend.
{
	auto_https off
}

:80 {
	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /uploads/* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:3000
	}
}
